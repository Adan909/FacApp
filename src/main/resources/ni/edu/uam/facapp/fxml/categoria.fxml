<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="350.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <top>
        <GridPane hgap="10.0" vgap="10.0" BorderPane.alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="80.0" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>
            <children>
                <Label text="Categoría:" />
                <TextField fx:id="txtNombre" GridPane.columnIndex="1" />

                <CheckBox fx:id="chkActiva" text="Activa" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </children>
        </GridPane>
    </top>
    <center>
        <TableView prefHeight="180.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn prefWidth="300.0" text="Nombre" />
                <TableColumn prefWidth="150.0" text="Estado" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="10.0" top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <Button text="Guardar" />
                <Button text="Cerrar" />
            </children>
        </HBox>
    </bottom>
</BorderPane>